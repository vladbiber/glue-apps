// Optional, for sessions without a polkit agent (phones): lets an active local
// wheel user install, remove and update apps through Glue Apps without a password.
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.glue.apps.") == 0 && subject.local && subject.active
            && subject.isInGroup("wheel"))
        return polkit.Result.YES;
});
