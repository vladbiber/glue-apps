[Desktop Entry]
Name=Glue Apps
Comment=Install apps and keep the whole system up to date
Comment[ro]=Instalează aplicații și ține tot sistemul la zi
Exec=glue-apps %f
MimeType=application/vnd.appimage;application/x-iso9660-appimage;
Icon=org.glue.Apps
Terminal=false
Type=Application
Categories=System;PackageManager;
Keywords=apps;store;software;install;update;upgrade;flatpak;aur;pacman;appimage;
StartupNotify=true
